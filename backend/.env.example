# Run uvicorn from backend/. Copy this file to .env.
DATABASE_URL=postgresql://rag_reader:CHANGE_ME@localhost:25432/rag
# Optional existing writer/admin connection for CLI ingestion only.
# Prefer interactive --database-user rag_admin --prompt-password for one-off imports.
INGEST_DATABASE_URL=
# Must be enabled explicitly; only local development is supported initially.
APP_ENV=local
DEV_AUTH_ENABLED=true
DEV_USER_ID=1
DEV_API_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN
# Separate administrative token for the local web UI and /dev endpoints.
DEV_ADMIN_TOKEN=CHANGE_ME_TO_ANOTHER_RANDOM_TOKEN
MAX_CONCURRENT_GENERATIONS=4
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=6000
MEMORY_REWRITE_MAX_TOKENS=384
DEEP_MAX_STEPS=12
DEEP_MAX_SEARCHES=3
DEEP_RETRY_LIMIT=1
DEEP_TIMEOUT_SECONDS=240
DEEP_MAX_TOKENS=1500
DEEP_CONTEXT_CHARS=14000
DEEP_CONTEXT_TOKENS=8192
# Optional served model ID for deep mode. Empty = use LLM_MODEL.
DEEP_LLM_MODEL=
DEEP_LLM_BASE_URL=
DEEP_LLM_PROVIDER=
DEEP_LLM_API_KEY=
DEEP_STRUCTURED_OUTPUT=true

# Keep blank until the embedding service is deployed.
# Expected API: POST {EMBEDDING_BASE_URL}/embeddings (OpenAI compatible).
# Example later: http://localhost:8002/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b
# For vLLM later: LLM_PROVIDER=openai, LLM_BASE_URL=http://localhost:8001/v1,
# LLM_MODEL=<served-model-name>. No database changes required.
# For LM Studio: LLM_PROVIDER=lmstudio, LLM_BASE_URL=http://172.19.0.1:5985/v1,
# LLM_MODEL=<language-model-id-from-/v1/models> (not the embedding model).
# Character budgets must fit the context actually loaded by the server.
GENERATION_CONTEXT_CHARS=14000
LLM_CONTEXT_TOKENS=8192
LLM_MAX_TOKENS=1000
HTTP_TIMEOUT_SECONDS=180

MEMORY_SUMMARY_ENABLED=true
SUMMARY_LLM_PROVIDER=
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_MODEL=
SUMMARY_LLM_API_KEY=
SUMMARY_INPUT_CHARS=4000
SUMMARY_MAX_CHARS=1000
SUMMARY_MAX_TOKENS=384
